<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.m000gg</groupId>
    <artifactId>unit-billing-plugins</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>unit-billing-plugins</name>
    <description>Plugin ecosystem for the Unit Billing platform — payment gateways, notifications, analytics, and other integrations</description>

    <modules>
        <module>analytics-plugins/analytics-dashboard</module>
    </modules>

    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- ===================== SHARED DEPENDENCIES ===================== -->
    <!-- Common to every plugin module; module-specific dependencies (Stripe/PayPal SDKs, Telegram Bots API, etc.)
         belong in each plugin's own pom.xml, not here. -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===================== TESTING ===================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- ===================== SHARED VERSION MANAGEMENT ===================== -->
    <!-- Pin versions of third-party SDKs here once plugin modules need them, so every
         module resolves the same version without repeating it in each child pom.xml. -->
    <dependencyManagement>
        <dependencies>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>