<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.m000gg</groupId>
    <artifactId>unit-billing-plugins</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>unit-billing-plugins</name>
    <description>Official plugins for the Unit Billing platform</description>

    <modules>
        <module>notification-plugins/email-notifier</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <plugin-api.version>0.1.0</plugin-api.version>
    </properties>

    <!-- ===================== SHARED DEPENDENCIES ===================== -->
    <!-- Common to every plugin module. Module-specific libraries (Telegram Bots API,
         mail, payment SDKs) belong in each plugin's own pom.xml, not here. -->
    <dependencies>
        <!-- Plugin contract: supplied by the application at runtime, NOT packaged into the plugin jar -->
        <dependency>
            <groupId>com.m000gg</groupId>
            <artifactId>unit-billing-plugin-api</artifactId>
            <version>${plugin-api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ===================== TESTING ===================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Plugins are plain jars with their own libraries inside (no Spring Boot repackaging).
                     Enable it only in modules that produce a plugin jar, not in group modules. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>